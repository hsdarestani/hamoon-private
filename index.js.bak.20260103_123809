  // Hetzner: پرایوت‌کی‌ای نزد ما نیست که پاک شود
  await deleteKeyPairFromDb(serverId).catch(()=>{});
}

        if (isTestServer) {
            await deleteTestServer(serverId);
        } else {
            await updatePurchaseStatus(serverId, 'deleted');
