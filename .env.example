# Telegram
TELEGRAM_BOT_TOKEN=
HOST_BOT_TOKEN=
SUPPORT_ID=
SUPPORT_USERNAME=

# Dashboard
ADMIN_DASHBOARD_USER=
ADMIN_DASHBOARD_PASSWORD=
ADMIN_DASHBOARD_SESSION_SECRET=
DASHBOARD_SECURE_COOKIE=true
DASHBOARD_PUBLIC_URL=https://pay.hamooncloud.ir

# Secure browser console (noVNC)
# Must be a public HTTPS base URL that serves /console.
CONSOLE_PUBLIC_BASE_URL=https://pay.hamooncloud.ir
# Production value must be at least 32 characters and must never be committed.
CONSOLE_SESSION_SECRET=

# Hetzner
HETZNER_API_TOKEN=
HETZNER_SSH_PUBLIC_KEY=
HETZNER_DEFAULT_LOCATION=nbg1
HETZNER_LOCATION=nbg1
HETZNER_ALLOWED_SERVER_TYPES=
HETZNER_DISABLED_SERVER_TYPES=

# Pricing
USD_TO_TOMAN=
USD_MARGIN=

# OpenStack
OS_AUTH_URL=
OS_INTERFACE=public
OS_IDENTITY_API_VERSION=3
OS_PROJECT_ID=
OS_PROJECT_DOMAIN_ID=default
OS_USER_DOMAIN_NAME=Default
OS_USERNAME=
OS_PASSWORD=
OS_NETWORK_ID=
OS_TEST_FLAVOR_ID=
OS_TEST_IMAGE_ID=

# Database
DB_HOST=127.0.0.1
DB_USER=
DB_PASSWORD=
DB_NAME=hamooncloud_db
DB_AUTO_INIT=true
SERVER_SECRET_KEY=

# Afracloud
AFRACLOUD_API_KEY=
AFRACLOUD_SECRET_KEY=
AFRACLOUD_ZONE_UUID=
AFRACLOUD_NETWORK_UUID=
AFRACLOUD_STORAGE_OFFERING_UUID=

# Optional reseller API smoke key for CI/server-side read-only checks
HAMOON_RESELLER_TEST_KEY=
