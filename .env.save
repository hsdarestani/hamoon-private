# تنظیمات پایگاه داده MySQL
# این مقادیر را با اطلاعات واقعی سرور MySQL خود جایگزین کنید.
# اگر MySQL روی همان سروری که ربات اجرا می‌شود نصب شده است، معمولاً 'localhost' یا '127.0.0.1' است.
DB_HOST=127.0.0.1 
# نام کاربری دیتابیس MySQL. معمولاً 'root' برای توسعه محلی است.
DB_USER=hamoon_user
# رمز عبور دیتابیس MySQL. برای نصب‌های جدید ممکن است خالی باشد یا رمز عبور تنظیم شده باشد.
DB_PASSWORD=YOUR_STRONG_PASSWORD
# نام دیتابیس که در db.js تعریف شده است. مطمئن شوید این دیتابیس در MySQL شما ایجاد شده باشد.
DB_NAME=hamooncloud_db 

