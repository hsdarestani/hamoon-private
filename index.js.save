  return sendMessage(chatId, msg, { parse_mode: 'MarkdownV2', reply_markup: { inline_keyboard: kb } });
}



function maskSecret(s) {
  if (!s) return String(s);
  const str = String(s);
  if (str.length <= 6) return '*'.repeat(str.length);
  return str.slice(0, 2) + '***' + str.slice(-2);
}



async function handleResetPasswordConfirm(chatId, serverId, dcConfig, messageId) {
  bot.editMessageText('⏳ در حال ریست کردن رمز عبور...', {
    chat_id: chatId,
    message_id: messageId,
    reply_markup: null
  }).catch(()=>{});

  try {
    const tok = await openstackApi.getToken(dcConfig);

    // برای OpenStack یک پسورد پیشنهادی می‌سازیم؛
    // در Hetzner این نادیده گرفته می‌شه و خودش پسورد می‌سازه.
    const suggestedPassword = `Hamoon_${crypto.randomBytes(6).toString('hex')}`;

    // ✅ اینجا خروجی رو نگه داریم:
    // - در Hetzner: API خودش پسورد می‌سازه و برمی‌گردونه (string)
    // - در OpenStack: معمولاً چیزی برنمی‌گردونه (null/undefined)
    const returned = await openstackApi.resetServerPassword(dcConfig, tok, serverId, suggestedPassword);

    console.log('[RESET_PW] provider=', dcConfig.provider, 'dc=', dcConfig.key, 'server=', serverId, {
      truthy: !!returned,
      type: typeof returned,
      length: returned ? String(returned).length : 0,
      sample: maskSecret(returned)
    });

    // پسورد نهایی: اگر API چیزی داد، همون؛ وگرنه همون پیشنهادی ما
    const finalPassword = returned || suggestedPassword;

    const purchase = await getPurchaseByServerId(serverId);
let serverName = purchase?.server_name || serverId;
try {
  const srv = await openstackApi.getServer(dcConfig, tok, serverId);
  serverName = srv?.name || serverName;
} catch (_) {}
    // متن را با HTML بساز (چون از <b> و <pre><code> استفاده می‌کنیم)
    const messageHtml =
      `✅ رمز عبور سرور <b>${htmlEscape(purchase?.server_name || serverId)}</b> با موفقیت ریست شد.` + '\n\n' +
      `🔑 <b>رمز عبور روت جدید شما:</b>` +
      htmlCodeBlock(finalPassword);

    // 👈 مهم: parse_mode = 'HTML'
    sendMessage(chatId, messageHtml, { parse_mode: 'HTML' });

    logServerEvent({
      type: 'server_password_reset',
      server_id: serverId,
      user_id: String(purchase?.telegram_id),
      datacenter: dcConfig.key
    });

  } catch (e) {
    console.error(`Reset Password Confirm Error for ${serverId}:`, e);
    sendMessage(chatId, `❌ عملیات ریست رمز عبور با خطا مواجه شد: ${escapeMarkdownV2(e.message)}`, { parse_mode: 'MarkdownV2' });
  }
}
	

// 🛑 Suspend server (admin only)
bot.onText(/\/suspend (.+)/, async (msg, match) => {
    if (String(msg.from.id) !== String(SUPPORT_ID)) return;

    const serverId = match[1].trim();
    const purchase = await getPurchaseByServerId(serverId);  // ✅ مستقیم

    if (!purchase) {
        return sendMessage(msg.chat.id, `❌ سروری با ID ${serverId} پیدا نشد.`);
    }

    //const dcConfig = datacenters[purchase.datacenter];
const dcMap    = getUserEffectiveDCs(String(purchase.telegram_id));
const dcConfig = dcMap?.[purchase.datacenter];
if (!dcConfig) {
  return sendMessage(msg.chat.id, `❌ دیتاسنتر ${purchase.datacenter} برای این کاربر پیدا نشد.`);
}    
if (!dcConfig) {
        return sendMessage(msg.chat.id, `❌ دیتاسنتر ${purchase.datacenter} تعریف نشده.`);
    }

    try {
        const token = await openstackApi.getToken(dcConfig);
        await openstackApi.suspendServer(dcConfig, token, serverId);
        sendMessage(msg.chat.id, `⏸️ سرور ${serverId} ساسپند شد.`);
    } catch (err) {
        console.error(`[ADMIN_SUSPEND_ERROR]`, err);
        sendMessage(msg.chat.id, `❌ خطا در suspend سرور ${serverId}: ${err.message}`);
    }
});

// ▶️ Resume server (admin only)
bot.onText(/\/resume (.+)/, async (msg, match) => {
    if (String(msg.from.id) !== String(SUPPORT_ID)) return;

    const serverId = match[1].trim();
    const purchase = await getPurchaseByServerId(serverId);  // ✅ مستقیم

    if (!purchase) {
        return sendMessage(msg.chat.id, `❌ سروری با ID ${serverId} پیدا نشد.`);
    }

  //  const dcConfig = datacenters[purchase.datacenter];
const dcMap    = getUserEffectiveDCs(String(purchase.telegram_id));
const dcConfig = dcMap?.[purchase.datacenter];
if (!dcConfig) {
  return sendMessage(msg.chat.id, `❌ دیتاسنتر ${purchase.datacenter} برای این کاربر پیدا نشد.`);
}   
 if (!dcConfig) {
        return sendMessage(msg.chat.id, `❌ دیتاسنتر ${purchase.datacenter} تعریف نشده.`);
    }

    try {
        const token = await openstackApi.getToken(dcConfig);
        await openstackApi.resumeServer(dcConfig, token, serverId);
        sendMessage(msg.chat.id, `▶️ سرور ${serverId} resume شد.`);
    } catch (err) {
        console.error(`[ADMIN_RESUME_ERROR]`, err);
        sendMessage(msg.chat.id, `❌ خطا در resume سرور ${serverId}: ${err.message}`);
    }
});

